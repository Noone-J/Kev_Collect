{% extends 'base.html.twig' %}

{% block title %}Hello AcceuilController!{% endblock %}

{% block body %}

{% block nav %}
    {% include 'layouts/navadmin.html.twig' %}
{% endblock %}

<div class="container">
    
    <div class="card mb-12" style="margin-top: 70px">
        <div class="row g-0">
            <div class="col-md-4">
            <img src="{{asset('uploads/images/'~produit.image)}}" class="img-fluid rounded-start" alt="...">
            </div>
            <div class="col-md-8">
            <div class="card-body">
                <h1 class="card-title">{{produit.libeller}}</h1>
                <p class="card-text">{{produit.description}}</p>
                <a href="" class="btn btn-success">Ajouter au panier</a>
                <p class="card-text"><small class="text-body-secondary">Last updated 3 mins ago</small></p>
            </div>
            </div>
        </div>
    </div>

    <h2>Derniers produits ajouter</h2>

    <div class="row">
        {% for produit in produits %}
            <div class="col-md-3 mt-4">
                <div class="card" style="width: 18rem;">
                    <img src="{{asset('uploads/images/'~produit.image)}}" class="card-img-top" alt="...">
                    <div class="card-body">
                        <a style="text-decoration: none; color: green" href="{{ path('app_produit_info',{'id':produit.id})}}"><h5 class="card-title">{{ produit.libeller }}</h5></a>
                        <p class="card-text">{{ produit.description|slice(0,50) }}</p>
                        <a href="#" class="btn btn-outline-success">Ajouter aux panier</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>


</div>
{% endblock %}
