{% extends "base.html.twig" %}

{% block body %}
<h1>Ajouter un produit à la commande #{{ commande.id }}</h1>

    <form action="" method="post">
        {{ form_widget(form) }}
        <button type="submit">Ajouter au panier</button>
    </form>

    <a href="{{ path('app_commande_show', {'id': commande.id}) }}">Retour à la commande</a>
{% endblock %}
