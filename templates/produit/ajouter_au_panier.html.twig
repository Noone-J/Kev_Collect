{% extends 'base.html.twig' %}

{% block title %}Ajouter {{ produit.libeller }} au panier{% endblock %}

{% block body %}
    <h1>Ajouter {{ produit.libeller }} au panier</h1>

    <form action="{{ path('app_commande_ajouter_produit', {'id': produit.id}) }}" method="post">
        <label for="quantite">Choisissez la quantité :</label>
        <input type="number" id="quantite" name="quantite" min="1" required>
        <button type="submit">Ajouter au panier</button>
    </form>
{% endblock %}