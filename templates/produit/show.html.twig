{% extends 'base.html.twig' %}

{% block title %}Info Produit{% endblock %}

{% block body %}

    {% block nav %}
        {% include 'layouts/navadmin.html.twig' %}
    {% endblock %}

    <h1>Produit</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ produit.id }}</td>
            </tr>
            <tr>
                <th>Libeller</th>
                <td>{{ produit.libeller }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ produit.description }}</td>
            </tr>
            <tr>
                <th>Prix_unitaire</th>
                <td>{{ produit.prixUnitaire }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_produit_index') }}" class="btn btn-outline-primary">Retour à la liste</a>

    <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" class="btn btn-outline-primary">Modifier</a>

    {{ include('produit/_delete_form.html.twig') }}
{% endblock %}
